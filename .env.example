# Fojansa · Panel — variables de entorno. Copiar a .env.local para desarrollo.
# Los valores reales viven en Vercel (demo) o en el .env del servidor de Fojansa (Docker). Nunca en el repo.

# ── Clerk (proyecto "Fojansa Panel", pendiente de crear) ──
# Sin estas dos claves, en desarrollo el panel abre sin login (usuario "Desarrollo"); en producción se rechaza todo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# Opcional: emails que pueden entrar, separados por comas (Guillermo y oficina). Vacío = cualquier usuario de la instancia.
PANEL_EMAILS_PERMITIDOS=

# ── Supabase ORKESTA_OPS_2026 (solo servidor; nunca NEXT_PUBLIC_*) ──
SUPABASE_URL=https://ddruuldwacxvvhvhjomm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Chat del panel → flujo n8n "Fojansa DEMO · Avisos por chat" ──
N8N_CHAT_WEBHOOK_URL=https://acgrowthmarketing.app.n8n.cloud/webhook/fojansa-chat
# Opcional: se envía como cabecera x-orkesta-token si el webhook lo exige.
N8N_CHAT_TOKEN=

# ── Token para que n8n llame a POST /api/avisos/vincular (Bearer). Mínimo 32 caracteres. ──
FOJANSA_API_TOKEN=
